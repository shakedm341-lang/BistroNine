<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ServerInitController">
   <children>
      <Label text="Database Initialization (Mock)">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" maxWidth="300.0" spacing="10.0">
         <children>
            <Label text="MySQL Password:" />
            <PasswordField fx:id="txtDbPassword" promptText="Enter DB Password" />
         </children>
      </VBox>
      <Button fx:id="btnInitialize" mnemonicParsing="false" onAction="#onInitializeClicked" text="Initialize DB" />
      <Button fx:id="btnSkip" mnemonicParsing="false" onAction="#onSkipClicked" text="Skip Initialization" />
   </children>
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>
</VBox>