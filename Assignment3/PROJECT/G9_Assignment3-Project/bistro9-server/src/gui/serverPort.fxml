<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" style="-fx-background-color: #f4f4f4;" stylesheets="@server_style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ServerPortFrameController">
   
   <children>
      <Label text="Setup Server">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER" maxWidth="300.0" spacing="5.0">
         <children>
            <Label text="Port:" />
            <TextField fx:id="portxt" alignment="CENTER" text="5555" />
         </children>
      </VBox>
      
      <VBox alignment="CENTER" maxWidth="300.0" spacing="5.0">
         <children>
            <Label text="DB Password:" />
            <PasswordField fx:id="dbPassTxt" alignment="CENTER" promptText="Enter DB Password" />
         </children>
      </VBox>
      
      <Button fx:id="btnDone" mnemonicParsing="false" onAction="#Done" prefWidth="150.0" styleClass="connect-btn" text="Connect">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
      
   </children>
   
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>