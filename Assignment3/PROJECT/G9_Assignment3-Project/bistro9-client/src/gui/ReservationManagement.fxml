<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="gui.ReservationManagementController">

    <VBox styleClass="card" spacing="15.0" maxHeight="Infinity" maxWidth="Infinity">
        
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <VBox spacing="10.0">
            <Label text="Reservation Management Operations" styleClass="subtitle-text" style="-fx-font-weight: bold;"/>
            
            <HBox spacing="15.0" alignment="BOTTOM_LEFT">
                <VBox spacing="5.0">
                    <Label text="Search Mode" style="-fx-font-size: 11px; -fx-text-fill: #777;"/>
                    <ComboBox fx:id="searchModeCombo" prefWidth="180" promptText="Select Search Mode" 
                              styleClass="combo-box-modern" />
                </VBox>
                
                <Separator orientation="VERTICAL" prefHeight="40.0" />
                
                <!-- Mode: Show All -->
                <HBox fx:id="allBox" spacing="10.0" alignment="BOTTOM_LEFT" visible="false" managed="false">
                    <VBox spacing="5.0">
                        <Label text=" " style="-fx-font-size: 11px;"/>
                        <Button text="Fetch All Reservations" onAction="#handleGetAll" 
                                styleClass="btn-secondary" prefWidth="180"/>
                    </VBox>
                </HBox>
                
                <!-- Mode: By Attribute -->
                <HBox fx:id="attributeBox" spacing="10.0" alignment="BOTTOM_LEFT" visible="false" managed="false">
                    <VBox spacing="5.0">
                        <Label text="Search By" style="-fx-font-size: 11px; -fx-text-fill: #777;"/>
                        <ComboBox fx:id="attributeCombo" promptText="Select Attribute" prefWidth="150" 
                                  styleClass="combo-box-modern" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="Search Value" style="-fx-font-size: 11px; -fx-text-fill: #777;"/>
                        <StackPane>
                            <TextField fx:id="attributeValueField" promptText="Enter Value" prefWidth="150" styleClass="text-field-modern" />
                            <ComboBox fx:id="statusComboBox" promptText="Select Status" prefWidth="150" visible="false" managed="false" 
                                      styleClass="combo-box-modern" />
                        </StackPane>
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text=" " style="-fx-font-size: 11px;"/>
                        <Button text="Search" onAction="#handleSearchByAttribute" 
                                styleClass="btn-primary" />
                    </VBox>
                </HBox>
                
                <!-- Mode: By Date Range -->
                <HBox fx:id="dateRangeBox" spacing="10.0" alignment="BOTTOM_LEFT" visible="false" managed="false">
                    <VBox spacing="5.0">
                        <Label text="Start Date" style="-fx-font-size: 11px; -fx-text-fill: #777;"/>
                        <DatePicker fx:id="startDatePicker" promptText="Start Date" prefWidth="140" styleClass="date-picker-modern" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="End Date" style="-fx-font-size: 11px; -fx-text-fill: #777;"/>
                        <DatePicker fx:id="endDatePicker" promptText="End Date" prefWidth="140" styleClass="date-picker-modern" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text=" " style="-fx-font-size: 11px;"/>
                        <Button text="Filter by Date" onAction="#handleSearchByDateRange" 
                                styleClass="btn-primary" />
                    </VBox>
                </HBox>
            </HBox>
        </VBox>

        <Separator />

        <TableView fx:id="reservationsTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDateTime" text="Date &amp; Time" prefWidth="180.0" />
                <TableColumn fx:id="colGuests" text="Guests" prefWidth="80.0" />
                <TableColumn fx:id="colConfirmationCode" text="Code" prefWidth="100.0" />
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100.0" />
                <TableColumn fx:id="colTotalPaid" text="Total Paid" prefWidth="100.0" />
                <TableColumn fx:id="colAction" text="Action" prefWidth="120.0" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>
