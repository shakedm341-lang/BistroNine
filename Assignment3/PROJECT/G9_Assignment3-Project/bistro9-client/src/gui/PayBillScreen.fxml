<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="gui.PayBillController"
           style="-fx-padding: 20;">

    <VBox styleClass="card" spacing="20.0" maxHeight="-Infinity" maxWidth="600" alignment="TOP_CENTER">
        
        <HBox alignment="CENTER" spacing="15.0">
            <Label text="Payment Portal" styleClass="title-text"/>
        </HBox>

        <Separator />

        <StackPane VBox.vgrow="ALWAYS">
            
            <VBox fx:id="searchSection" alignment="CENTER" spacing="25.0" maxWidth="450">
                <padding><Insets top="30" bottom="30"/></padding>
                
                <VBox alignment="CENTER" spacing="10.0">
                    <Label text="Find Your Bill" styleClass="subtitle-text" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Please enter the confirmation code received via SMS/Email" 
                           style="-fx-text-fill: -text-secondary; -fx-font-size: 13px;" wrapText="true"/>
                </VBox>

                <VBox spacing="15.0" alignment="CENTER">
                    <TextField fx:id="txtConfCode" promptText="Enter Confirmation Code (e.g. 5523)" 
                               styleClass="text-field-modern" style="-fx-font-size: 16px; -fx-alignment: CENTER;" 
                               prefHeight="50.0" maxWidth="300"/>
                    
                    <Button fx:id="btnSearch" onAction="#handleSearch" text="Fetch Bill Details" 
                            styleClass="btn-primary" prefHeight="45.0" prefWidth="200.0"/>
                </VBox>
            </VBox>


            <VBox fx:id="billDetailsSection" spacing="20.0" visible="false">
                
                <HBox spacing="20.0" alignment="CENTER">
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #F7FAFC; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="Bill ID" styleClass="input-label"/>
                        <Label fx:id="lblBillId" text="-" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #F7FAFC; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="Reservation ID" styleClass="input-label"/>
                        <Label fx:id="lblReservationId" text="-" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    </VBox>
                </HBox>

                <VBox styleClass="form-bg">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Original Amount" style="-fx-text-fill: -text-secondary; -fx-font-size: 14px;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblOriginalAmount" text="0.00 ₪" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </HBox>

                    <Separator style="-fx-opacity: 0.3; -fx-padding: 10 0;" />

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Discount applied:" style="-fx-text-fill: -text-secondary; -fx-font-size: 14px;"/>
                        <Label fx:id="lblDiscountType" text="-" style="-fx-text-fill: -text-secondary; -fx-font-size: 14px; -fx-padding: 0 0 0 5;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblDiscount" text="0%" style="-fx-text-fill: -success-green; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    </HBox>

                    <Separator style="-fx-padding: 15 0;" />

                    <HBox alignment="CENTER_LEFT">
                        <Label text="TOTAL TO PAY" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: -primary-blue;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalAmount" text="0.00 ₪" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: -primary-blue;"/>
                    </HBox>
                </VBox>

                <VBox spacing="10.0">
                    <Label text="Payment Method" styleClass="input-label"/>
                    <ComboBox fx:id="comboPaymentMethod" promptText="Select Method" maxWidth="Infinity" 
                              style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-font-size: 14px; -fx-pref-height: 40;"/>
                </VBox>

                <HBox spacing="15.0" alignment="CENTER">
                    <Button onAction="#handleBack" text="Cancel" 
                            styleClass="btn-danger-outline" prefHeight="50.0" prefWidth="120.0"/>
                    
                    <Button fx:id="btnPay" onAction="#handlePay" text="PAY NOW" 
                            styleClass="btn-success" prefHeight="50.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-font-size: 18px;"/>
                </HBox>

            </VBox>
        </StackPane>
        
        <Button fx:id="btnBackOnly" onAction="#handleBack" text="Back" 
                styleClass="btn-danger-outline" prefHeight="40.0" prefWidth="150.0"/>
    </VBox>
</StackPane>