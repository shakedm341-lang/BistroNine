<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="main-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ConnectToServerController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="25.0" styleClass="card">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label styleClass="title-text" text="Server Connection" />
                  <Label styleClass="subtitle-text" text="Configure the connection to the system" />
               </children>
            </VBox>
            
            <VBox spacing="15.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="input-label" text="Server IP Address" />
                        <TextField fx:id="ipTxt" promptText="e.g. localhost" styleClass="text-field-modern" text="localhost" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="input-label" text="Port Number" />
                        <TextField fx:id="portTxt" promptText="e.g. 5555" styleClass="text-field-modern" text="5555" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#connectToServer" prefHeight="45.0" prefWidth="200.0" styleClass="btn-primary" text="Connect to Server" />
                  <Button mnemonicParsing="false" onAction="#exitApplication" prefHeight="45.0" prefWidth="200.0" styleClass="btn-danger-outline" text="Exit" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
      </VBox>
   </children>
</StackPane>