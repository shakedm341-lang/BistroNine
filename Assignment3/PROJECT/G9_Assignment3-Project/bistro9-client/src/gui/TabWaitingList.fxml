<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="gui.TabWaitingListController">

    <padding>
        <Insets top="10.0" bottom="10.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnRemove" onAction="#handleRemove" text="Remove Selected" 
                        styleClass="btn-danger-outline"/>

                <Button fx:id="btnRefresh" onAction="#handleRefresh" text="Refresh" 
                        styleClass="btn-secondary-dark"/>
            </children>
        </HBox>

        <TableView fx:id="waitingTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFirstName" text="First Name" prefWidth="120" />
                <TableColumn fx:id="colLastName" text="Last Name" prefWidth="120" />
                <TableColumn fx:id="colPhone" text="Phone Number" prefWidth="130" />
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180" />
                <TableColumn fx:id="colEntryTime" text="Waiting Since" prefWidth="120" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>