<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0"
	xmlns="http://javafx.com/javafx/8.0.171"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="gui.TabActiveReservationController">

	<padding>
		<Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
	</padding>

	<children>
		<HBox alignment="CENTER_LEFT" spacing="20.0">
			<children>
				<Label text="Active Reservations" textFill="#333333">
					<font>
						<Font name="System Bold" size="18.0" />
					</font>
				</Label>
				<VBox HBox.hgrow="ALWAYS" />
				<Button mnemonicParsing="false" onAction="#onRefreshClicked"
					style="-fx-background-color: #2196f3;" text="Refresh List"
					textFill="WHITE">
					<font>
						<Font name="System Bold" size="12.0" />
					</font>
				</Button>
			</children>
		</HBox>

		<TableView fx:id="tblReservations" prefHeight="200.0"
			prefWidth="200.0" VBox.vgrow="ALWAYS">
			<columns>
				<TableColumn fx:id="colResId" prefWidth="70.0"
					text="Res ID" />
				<TableColumn fx:id="colCustomerId" prefWidth="90.0"
					text="Customer ID" />
				<TableColumn fx:id="colTableId" prefWidth="70.0"
					text="Table #" />
				<TableColumn fx:id="colDiners" prefWidth="70.0"
					text="Diners" />
				<TableColumn fx:id="colDate" prefWidth="150.0"
					text="Reservation Time" />
				<TableColumn fx:id="colStatus" prefWidth="100.0"
					text="Status" />
				<TableColumn fx:id="colArrived" prefWidth="150.0"
					text="Arrival Time" />
			</columns>
			<columnResizePolicy>
				<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
			</columnResizePolicy>
		</TableView>

		<Label
			text="* Selecting a row will allow further actions (Edit/Cancel/Mark Arrived)"
			textFill="#888888">
			<font>
				<Font size="11.0" />
			</font>
		</Label>
	</children>
</VBox>