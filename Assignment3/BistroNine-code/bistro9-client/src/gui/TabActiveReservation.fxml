<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="gui.TabActiveReservationController">

    <padding>
        <Insets top="10.0" bottom="10.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button mnemonicParsing="false" onAction="#onRefreshClicked"
                        styleClass="btn-secondary-dark" text="Refresh List"/>
            </children>
        </HBox>

        <TableView fx:id="tblReservations" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colResId" prefWidth="70.0" text="Res ID" />
                <TableColumn fx:id="colCustomerId" prefWidth="90.0" text="Customer ID" />
                <TableColumn fx:id="colTableId" prefWidth="70.0" text="Table #" />
                <TableColumn fx:id="colDiners" prefWidth="70.0" text="Diners" />
                <TableColumn fx:id="colDate" prefWidth="160.0" text="Reservation Time" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                <TableColumn fx:id="colArrived" prefWidth="150.0" text="Arrival Time" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>