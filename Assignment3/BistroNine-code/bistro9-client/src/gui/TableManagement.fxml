<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.TableManagementController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="Table Management Center" textFill="#2196f3">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#refreshTableData" text="Refresh" />
         </children>
      </HBox>

      <VBox spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Restaurant Tables" font="$x1">
               <font>
                  <Font name="System Bold" size="16.0" fx:id="x1" />
               </font>
            </Label>
            <TableView fx:id="tablesTable" prefHeight="300.0" prefWidth="760.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idCol" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="seatsCol" prefWidth="100.0" text="Seats" />
                <TableColumn fx:id="locationCol" prefWidth="150.0" text="Location" />
                <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="actionsCol" prefWidth="250.0" text="Actions" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

      <VBox spacing="10.0" style="-fx-border-color: #ddd; -fx-border-width: 1; -fx-padding: 15; -fx-border-radius: 5;">
         <children>
            <Label text="Add New Table" font="$x1" />
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Seats:" />
                        <Spinner fx:id="seatsSpinner" prefWidth="80.0" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Location:" />
                        <ComboBox fx:id="locationComboBox" prefWidth="150.0" />
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#handleAddTable" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="+ Add Table">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="18.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>

