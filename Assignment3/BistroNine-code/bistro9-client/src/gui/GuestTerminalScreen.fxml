<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1100.0" spacing="0.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.GuestTerminalController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 0 30 0 30;">
         <children>
            <Label text="BistroNine Guest Terminal" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleExit" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="EXIT GUEST" />
         </children>
      </HBox>
      <TabPane fx:id="guestTabPane" side="TOP" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="New Order / Reservation">
               <content>
                  <fx:include fx:id="reservationScreen" source="NewReservation.fxml" />
               </content>
          </Tab>
          <Tab text="Leave Waitlist">
               <content>
                  <fx:include fx:id="leaveWaitlistScreen" source="LeaveWaitlistScreen.fxml" />
               </content>
          </Tab>
            <Tab text="Pay Bill">
               <content>
                  <fx:include fx:id="payBillScreen" source="PayBillScreen.fxml" />
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>

