<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="550.0" prefWidth="900.0" 
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="gui.LoginController">

   <VBox fx:id="sidebar" alignment="CENTER" prefWidth="380.0" style="-fx-background-color: linear-gradient(to bottom right, #2C5282, #2B6CB0);" HBox.hgrow="ALWAYS">
      <children>
         <Label text="BistroNine" textFill="WHITE">
            <font>
               <Font name="System Bold" size="40.0" />
            </font>
         </Label>
         <Label text="Restaurant Management System" textFill="#EBF8FF">
            <font>
               <Font size="16.0" />
            </font>
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin>
         </Label>
      </children>
   </VBox>

   <StackPane prefWidth="520.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
      <children>
         
         <VBox alignment="CENTER_LEFT" maxWidth="320.0" spacing="20.0">
            <children>
               
               <VBox spacing="5.0">
                  <Label text="Welcome Back" style="-fx-text-fill: -primary-blue;">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                  </Label>
                  <Label text="Please sign in to continue" style="-fx-text-fill: -text-secondary;" />
               </VBox>

               <VBox spacing="15.0">
                  <VBox spacing="5.0">
                     <Label text="Username" styleClass="input-label"/>
                     <TextField fx:id="usernameTxt" promptText="Enter username" 
                                styleClass="text-field-modern" prefHeight="40.0"/>
                  </VBox>

                  <VBox spacing="5.0">
                     <Label text="Password" styleClass="input-label"/>
                     <PasswordField fx:id="passwordTxt" promptText="Enter password" 
                                    styleClass="text-field-modern" prefHeight="40.0"/>
                  </VBox>
               </VBox>
               
               <Button mnemonicParsing="false" 
                       onAction="#getLoginBtn" text="Login" 
                       maxWidth="Infinity"
                       styleClass="btn-primary" prefHeight="45.0"
                       style="-fx-font-size: 14px;"/>

               <HBox fx:id="orSeparator" alignment="CENTER" spacing="10.0">
                  <Separator HBox.hgrow="ALWAYS" />
                  <Label text="OR" style="-fx-text-fill: -text-secondary; -fx-font-size: 12px;"/>
                  <Separator HBox.hgrow="ALWAYS" />
               </HBox>

               <Button fx:id="btnGuest" mnemonicParsing="false" 
                       onAction="#enterAsGuest" text="Enter as Guest" 
                       maxWidth="Infinity"
                       prefHeight="40.0"
                       styleClass="btn-guest"/>

               <Button fx:id="btnScanTag" managed="false" visible="false"
                       mnemonicParsing="false" onAction="#handleScanTag" 
                       text="Scan Employee Tag" 
                       maxWidth="Infinity"
                       prefHeight="40.0"
                       style="-fx-background-color: #ED8936; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

               <Button fx:id="btnBack" mnemonicParsing="false" onAction="#getBackBtn" 
                       text="Back to Main Menu" 
                       maxWidth="Infinity"
                       prefHeight="40.0"
                       styleClass="btn-danger-outline"/>

            </children>
         </VBox>
      </children>
   </StackPane>

</HBox>