<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="gui.MyReservationsController"
           style="-fx-padding: 20;">

    <VBox styleClass="card" spacing="15.0" maxHeight="Infinity" maxWidth="Infinity">
        
        <VBox spacing="5.0">
            <Label text="My Reservations History" styleClass="title-text"/>
            <Label text="Here you can view your past and future reservations. You can cancel active future reservations." 
                   styleClass="subtitle-text"/>
        </VBox>

        <Separator />

        <TableView fx:id="reservationsTable" styleClass="modern-table" VBox.vgrow="ALWAYS" minHeight="450.0">
            <columns>
                <TableColumn fx:id="colDateTime" prefWidth="180.0" text="Date &amp; Time" />
                <TableColumn fx:id="colGuests" prefWidth="80.0" text="Guests" />
                <TableColumn fx:id="colConfirmationCode" prefWidth="120.0" text="Conf. Code" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                
                <TableColumn fx:id="colAction" prefWidth="140.0" text="Action" />
            </columns>
            
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
</StackPane>