<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="main-background" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.TerminalIdentificationController">
   <children>
      
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="30.0" styleClass="card">
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
         
         <VBox alignment="CENTER" spacing="10.0">
            <children>
               <Label styleClass="title-text" text="Welcome to BistroNine" />
               <Label styleClass="subtitle-text" text="Please select your identification method to proceed" />
            </children>
         </VBox>
         
         <Separator prefWidth="200.0" />
         
         <HBox alignment="CENTER" spacing="30.0">
            <children>
               <Button contentDisplay="TOP" mnemonicParsing="false" onAction="#handleSubscriber" prefHeight="180.0" prefWidth="220.0" styleClass="tile-btn, tile-blue" text="I am a Subscriber">
                  <font>
                     <Font size="18.0" />
                  </font>
                  </Button>
               
               <Button contentDisplay="TOP" mnemonicParsing="false" onAction="#handleGuest" prefHeight="180.0" prefWidth="220.0" styleClass="tile-btn, tile-green" text="Continue as Guest">
                  <font>
                     <Font size="18.0" />
                  </font>
               </Button>
            </children>
            <VBox.margin>
               <Insets bottom="20.0" top="20.0" />
            </VBox.margin>
         </HBox>
         
         <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="150.0" styleClass="btn-danger-outline" text="Exit Terminal" />
         
      </VBox>
   </children>
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</StackPane>