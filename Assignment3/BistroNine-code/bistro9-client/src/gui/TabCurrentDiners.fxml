<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.TabCurrentDinersController">
    
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Label text="Current Diners (Arrived)" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox HBox.hgrow="ALWAYS" /> 
                <Button mnemonicParsing="false" onAction="#onRefreshClicked" style="-fx-background-color: #4caf50;" text="Refresh List" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <TableView fx:id="tblDiners" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                
                <TableColumn fx:id="colType" prefWidth="100.0" text="Type" />
                
                <TableColumn fx:id="colFirstName" prefWidth="100.0" text="First Name" />
                <TableColumn fx:id="colLastName" prefWidth="100.0" text="Last Name" />
                <TableColumn fx:id="colPhone" prefWidth="120.0" text="Phone" />
                <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        
        <Label text="* 'Guest' indicates a regular customer without a subscriber profile." textFill="#888888">
            <font>
                <Font size="11.0" />
            </font>
        </Label>
    </children>
</VBox>