<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="800.0" spacing="10.0"
	xmlns="http://javafx.com/javafx/8.0.171"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="gui.RestaurantManagementController">

	<children>
		<Label text="Restaurant Operations Center" textFill="#2196f3">
			<font>
				<Font name="System Bold" size="22.0" />
			</font>
			<VBox.margin>
				<Insets left="15.0" top="15.0" />
			</VBox.margin>
		</Label>

		<TabPane fx:id="opsTabPane" tabClosingPolicy="UNAVAILABLE"
			VBox.vgrow="ALWAYS">
			<tabs>

				<Tab fx:id="createReservationTab" text="Create New Reservation">
					<content>
						<fx:include fx:id="createReservationView"
							source="NewReservation.fxml" />
					</content>
				</Tab>

				<Tab fx:id="reservationManagementTab"
					text="Reservation Management">
					<content>
						<fx:include fx:id="reservationView"
							source="ReservationManagement.fxml" />
					</content>
				</Tab>

				<Tab fx:id="registerClientTab" text="Register Client">
					<content>
						<fx:include fx:id="registerClientView"
							source="RegisterClient.fxml" />
					</content>
				</Tab>

				<Tab fx:id="manageTablesTab" text="Manage Tables">
					<content>
						<AnchorPane />
					</content>
				</Tab>

				<Tab fx:id="waitingListTab" text="Waiting List">
					<content>
						<AnchorPane />
					</content>
				</Tab>

				<Tab fx:id="settingsTab" text="Settings">
					<content>
						<AnchorPane />
					</content>
				</Tab>

			</tabs>
		</TabPane>
	</children>

	<padding>
		<Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
	</padding>

</VBox>