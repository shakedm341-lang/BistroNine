<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0"
      prefWidth="680.0"
      spacing="10.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.RestaurantManagementController">

    <children>

        <!-- Header -->
        <Label text="Restaurant Operations Center"
               textFill="#2196f3">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
            <VBox.margin>
                <Insets left="15.0" top="15.0"/>
            </VBox.margin>
        </Label>

        <!-- Tabs -->
        <TabPane fx:id="opsTabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 VBox.vgrow="ALWAYS">

            <tabs>

                <!-- Register Client -->
                <Tab fx:id="registerClientTab"
                     text="Register Client">
                    <content>
                        <AnchorPane style="-fx-background-color: white;">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="Client Registration Form"
                                       textFill="#666666">
                                    <font>
                                        <Font size="18.0"/>
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- Manage Tables -->
                <Tab fx:id="manageTablesTab"
                     text="Manage Tables">
                    <content>
                        <AnchorPane style="-fx-background-color: white;">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="Table Management &amp; Layout"
                                       textFill="#666666">
                                    <font>
                                        <Font size="18.0"/>
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- Reservation Management -->
                <Tab fx:id="reservationManagementTab"
                     text="Reservation Management">
                    <content>
                        <!-- intentionally empty – loaded on selection -->
                        <AnchorPane/>
                    </content>
                </Tab>

                <!-- Waiting List -->
                <Tab fx:id="waitingListTab"
                     text="Waiting List">
                    <content>
                        <AnchorPane style="-fx-background-color: white;">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="Current Waiting List"
                                       textFill="#666666">
                                    <font>
                                        <Font size="18.0"/>
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- Settings -->
                <Tab fx:id="settingsTab"
                     text="Settings">
                    <content>
                        <AnchorPane style="-fx-background-color: white;">
                            <children>
                                <Label layoutX="20.0"
                                       layoutY="20.0"
                                       text="System Settings &amp; Opening Hours"
                                       textFill="#666666">
                                    <font>
                                        <Font size="18.0"/>
                                    </font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>

    </children>

    <padding>
        <Insets top="5.0"
                bottom="10.0"
                left="10.0"
                right="10.0"/>
    </padding>

</VBox>
