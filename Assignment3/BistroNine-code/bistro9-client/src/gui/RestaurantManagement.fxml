<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="gui.RestaurantManagementController"
           style="-fx-padding: 20;"> <VBox spacing="15.0" maxHeight="Infinity" maxWidth="Infinity">
        
        <VBox spacing="5.0">
            <Label text="Restaurant Operations" styleClass="title-text"/>
            <padding><Insets left="5"/></padding> 
        </VBox>

        <TabPane fx:id="opsTabPane" styleClass="modern-tab-pane" 
                 tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>

                <Tab fx:id="createReservationTab" text="Create Reservation">
                    <content>
                        <AnchorPane>
                            <fx:include fx:id="createReservationView" 
                                      source="NewReservation.fxml" 
                                      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab fx:id="reservationManagementTab" text="Reservations">
                    <content>
                        <fx:include fx:id="reservationView" source="ReservationManagement.fxml" />
                    </content>
                </Tab>

                <Tab fx:id="registerClientTab" text="Register Client">
                    <content>
                        <fx:include fx:id="registerClientView" source="RegisterClient.fxml" />
                    </content>
                </Tab>

                <Tab fx:id="manageTablesTab" text="Tables">
                    <content>
                        <fx:include fx:id="tableManagementView" source="TableManagement.fxml" />
                    </content>
                </Tab>

                <Tab fx:id="settingsTab" text="Settings">
                    <content>
                        <fx:include fx:id="settingsView" source="Settings.fxml" />
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </VBox>
</StackPane>