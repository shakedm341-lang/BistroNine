<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" spacing="20.0" styleClass="main-background" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.GetTableController">
   <children>
      
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label styleClass="title-text" text="Welcome to BistroNine">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </VBox>
      
      <StackPane fx:id="mainStack" maxWidth="750.0" VBox.vgrow="ALWAYS">
         <children>
            
            <VBox fx:id="checkInView" alignment="CENTER" styleClass="card">
               <children>
                  <VBox alignment="TOP_CENTER">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label fx:id="checkInTitle" styleClass="title-text" text="Reservation Check-In">
                                 <font>
                                    <Font name="System Bold" size="28.0" />
                                 </font>
                              </Label>
                              <Label fx:id="checkInGuidance" styleClass="subtitle-text" text="Select an active reservation or enter your code manually.">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="30.0" />
                           </padding>
                        </VBox>
                        <HBox alignment="TOP_CENTER" spacing="50.0">
                           <children>
                              
                              <VBox fx:id="subscriberCodesBox" alignment="TOP_CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="input-label" text="Your Active Codes">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <ListView fx:id="codesListView" prefHeight="250.0" prefWidth="280.0" styleClass="modern-list-view" />
                                 </children>
                              </VBox>
                              
                              <VBox alignment="CENTER" spacing="20.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="input-label" text="Manual Entry">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                        </font>
                                     </Label>
                                    <TextField fx:id="confCodeField" alignment="CENTER" maxWidth="250.0" promptText="Enter code" styleClass="text-field-modern" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                                    
                                    <Button mnemonicParsing="false" onAction="#handleCheckInByCode" prefHeight="55.0" prefWidth="220.0" styleClass="btn-primary" text="CHECK-IN">
                                        <font>
                                            <Font size="18.0"/>
                                        </font>
                                    </Button>
                                    
                                    <Button fx:id="lostCodeButton" mnemonicParsing="false" onAction="#handleShowRecovery" styleClass="link-text" text="I lost my code">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                    </Button>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <VBox fx:id="recoveryView" alignment="CENTER" spacing="20.0" styleClass="card" visible="false">
               <children>
                  <Label styleClass="title-text" text="Recover Your Code">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label styleClass="subtitle-text" text="Enter your details to receive your active codes via SMS/Email">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  
                  <VBox alignment="CENTER" maxWidth="300.0" spacing="15.0">
                     <children>
                        <TextField fx:id="recoveryPhoneField" alignment="CENTER" prefHeight="45.0" promptText="Phone Number" styleClass="text-field-modern" />
                        <TextField fx:id="recoveryEmailField" alignment="CENTER" prefHeight="45.0" promptText="Email Address" styleClass="text-field-modern" />
                     </children>
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleRecoverLostCodes" prefHeight="50.0" prefWidth="300.0" styleClass="btn-success" text="SEND MY CODES" />
                        
                        <Button mnemonicParsing="false" onAction="#handleShowCheckIn" styleClass="link-text" text="Return to Check-In">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
      
      <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="120.0" styleClass="btn-danger-outline" text="Back">
         <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
         </VBox.margin>
      </Button>
      
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>