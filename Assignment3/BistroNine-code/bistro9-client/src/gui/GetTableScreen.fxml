<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.GetTableController">
   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Welcome to BistroNine" textFill="#1976D2">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Label>
            <Label text="Please identify to receive your table" textFill="#555555">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </VBox>
      
      <StackPane fx:id="mainStack" maxWidth="750.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Screen 1: Check-In View -->
            <VBox fx:id="checkInView" alignment="CENTER" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 30;">
               <children>
                  <Label fx:id="checkInTitle" text="Enter Confirmation Code" textFill="#1976D2">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  
                  <HBox alignment="CENTER" spacing="50.0">
                     <children>
                        <!-- Way 1: By Code (Visible for all) -->
                        <VBox alignment="TOP_CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="codeSubtitle" alignment="CENTER" prefHeight="60.0" text="Option 1: By Code" textAlignment="CENTER" textFill="#1976D2" wrapText="true">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="confCodeField" alignment="CENTER" maxWidth="280.0" promptText="######" style="-fx-font-size: 26; -fx-background-radius: 5; -fx-font-weight: bold;" />
                              <Button mnemonicParsing="false" onAction="#handleCheckInByCode" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 18;" text="CHECK-IN" />
                           </children>
                        </VBox>

                        <!-- Way 2: By ReaderTag (Visible for subscribers only) -->
                        <VBox fx:id="tagIdentificationBox" alignment="TOP_CENTER" managed="false" spacing="15.0" visible="false" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox fx:id="scanTagView" alignment="TOP_CENTER" spacing="15.0">
                                 <children>
                                    <Label alignment="CENTER" prefHeight="60.0" text="Option 2: By ReaderTag" textAlignment="CENTER" textFill="#1976D2" wrapText="true">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <Button mnemonicParsing="false" onAction="#handleCheckInByTag" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 18;" text="SCAN TAG" />
                                    <Label text="(Use your Subscriber Tag)" textFill="#757575">
                                       <font>
                                          <Font size="13.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                              
                              <VBox fx:id="codesListViewContainer" alignment="TOP_CENTER" managed="false" spacing="10.0" visible="false">
                                 <children>
                                    <Label text="Select Your Reservation" textFill="#1976D2">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <ListView fx:id="codesListView" maxHeight="150.0" maxWidth="250.0" style="-fx-font-size: 16;" />
                                    <Button mnemonicParsing="false" onAction="#handleResetIdentification" style="-fx-background-color: transparent; -fx-text-fill: #757575; -fx-underline: true; -fx-cursor: hand;" text="Scan another tag">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Button>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <Button fx:id="lostCodeButton" mnemonicParsing="false" onAction="#handleShowRecovery" style="-fx-background-color: transparent; -fx-text-fill: #1976D2; -fx-underline: true; -fx-cursor: hand;" text="I lost my code">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
            
            <!-- Screen 2: Recovery View (Hidden by default) -->
            <VBox fx:id="recoveryView" alignment="CENTER" spacing="20.0" style="-fx-background-color: #fcfcfc; -fx-background-radius: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" visible="false">
               <children>
                  <Label text="Recover Your Code" textFill="#424242">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Enter your details to receive your active codes via SMS/Email" textFill="#757575">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  
                  <VBox alignment="CENTER" maxWidth="300.0" spacing="15.0">
                     <children>
                        <TextField fx:id="recoveryPhoneField" alignment="CENTER" prefHeight="40.0" promptText="Phone Number" style="-fx-font-size: 16; -fx-background-radius: 5;" />
                        <TextField fx:id="recoveryEmailField" alignment="CENTER" prefHeight="40.0" promptText="Email Address" style="-fx-font-size: 16; -fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleRecoverLostCodes" prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 18;" text="SEND MY CODES" />
                        <Button mnemonicParsing="false" onAction="#handleShowCheckIn" style="-fx-background-color: transparent; -fx-text-fill: #757575; -fx-underline: true; -fx-cursor: hand;" text="Return to Check-In">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;" text="Back">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
         </VBox.margin>
      </Button>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
