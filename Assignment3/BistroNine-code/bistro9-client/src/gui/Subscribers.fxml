<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="gui.SubscribersViewController">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="Subscribers List" textFill="#2196f3">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Button mnemonicParsing="false" onAction="#refreshTableData" text="Refresh Table" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </HBox>

      <TableView fx:id="subscribersTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="firstNameCol" prefWidth="100.0" text="First Name" />
          <TableColumn fx:id="lastNameCol" prefWidth="100.0" text="Last Name" />
          <TableColumn fx:id="phoneCol" prefWidth="120.0" text="Phone" />
          <TableColumn fx:id="emailCol" prefWidth="180.0" text="Email" />
          <TableColumn fx:id="typeCol" prefWidth="100.0" text="Type" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>