<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ConnectToServerController">
   
   <children>
      <Label text="Server Connection">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER" maxWidth="300.0" spacing="5.0">
         <children>
            <Label text="Server IP:" />
            <TextField fx:id="ipTxt" alignment="CENTER" promptText="e.g. localhost" text="localhost" />
         </children>
      </VBox>
      
      <VBox alignment="CENTER" maxWidth="300.0" spacing="5.0">
         <children>
            <Label text="Port:" />
            <TextField fx:id="portTxt" alignment="CENTER" promptText="e.g. 5555" text="5555" />
         </children>
      </VBox>
      
      <Button mnemonicParsing="false" onAction="#connectToServer" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Connect">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
   </children>
   
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>