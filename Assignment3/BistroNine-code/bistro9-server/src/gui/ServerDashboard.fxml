<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #deb887;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ServerDashboardController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Server Dashboard">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="clientTable" layoutX="14.0" layoutY="60.0" prefHeight="280.0" prefWidth="570.0">
        <columns>
          <TableColumn fx:id="ipCol" prefWidth="180.0" text="IP Address" />
          <TableColumn fx:id="hostCol" prefWidth="180.0" text="Host Name" />
          <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
        </columns>
      </TableView>
      <Button fx:id="btnExit" layoutX="534.0" layoutY="350.0" mnemonicParsing="false" onAction="#getExitBtn" style="-fx-background-color: skyblue; -fx-text-fill: red; -fx-font-weight: bold;" text="Exit" />
      <Label layoutX="14.0" layoutY="354.0" text="Server Status: Running" textFill="#0d6b12">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
   </children>
</Pane>