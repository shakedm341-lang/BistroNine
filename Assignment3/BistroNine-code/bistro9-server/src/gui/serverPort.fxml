      <Label layoutX="14.0" layoutY="95.0" text="DB Password:" />
      <PasswordField fx:id="dbPassTxt" layoutX="100.0" layoutY="91.0" prefHeight="25.0" prefWidth="149.0" />
      
      <Button fx:id="btnDone" layoutX="76.0" layoutY="146.0" mnemonicParsing="false" onAction="#Done" text="Done" />
      <Button fx:id="btnExit" layoutX="173.0" layoutY="146.0" mnemonicParsing="false" onAction="#getExitBtn" text="Exit" />
